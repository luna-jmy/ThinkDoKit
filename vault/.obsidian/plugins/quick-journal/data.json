  "summaryQueries": [
    {
      "title": "Inbox查询",
      "kind": "dataview",
      "code": "TABLE file.ctime AS \"创建日期\", file.mtime AS \"最后修改时间\"\nWHERE startswith(file.path, \"000 Inbox\") OR contains(tags, \"inbox\")\nWHERE file.name != \"Inbox Note List\"\nWHERE !startswith(file.path, \"500 Journal\")\nWHERE !contains(file.path, \"Clippings\")\nSORT file.mtime DESC"
    }
  ],
  "viewLocations": {
