filters:
  and:
    - type == "contacts"
views:
  - type: table
    name: 表格
    filters:
      and:
        - '!file.folder.contains("900 Assets")'
    order:
      - file.name
      - 证件姓名
      - 英文名
      - aliases
      - 关系
      - 籍贯
      - 所在地
      - remark
      - birthday
      - photo
      - priority
      - status
      - 阴历生日
      - 微信
      - 公司手机
      - 个人手机
      - 电子邮箱
    sort:
      - property: 公司手机
        direction: DESC
    columnSize:
      note.证件姓名: 80
      note.priority: 54
      note.微信: 96
      note.公司手机: 95
