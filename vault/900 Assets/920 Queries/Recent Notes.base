views:
  - type: table
    name: 最近新增资源笔记
    filters:
      and:
        - file.folder.contains("300 Resources")
        - and:
            - created >= today() - "7d"
    order:
      - file.name
      - aliases
      - type
      - status
    columnSize:
      note.type: 96
  - type: table
    name: 最近新增知识卡片
    filters:
      and:
        - file.folder.contains("600 Zettelkasten")
    order:
      - file.name
      - aliases
      - area
      - status
      - source
    columnSize:
      file.name: 180
  - type: table
    name: 最近发布文章
    filters:
      and:
        - file.folder.contains("文章")
        - or:
            - note["zhihu-publish"] >= today() - "60d"
            - note["wechat-publish"] >= today() - "60d"
            - created >= today() - "30d"
    order:
      - file.name
      - published
      - created
      - zhihu-publish
      - wechat-publish
    columnSize:
      note.published: 59
