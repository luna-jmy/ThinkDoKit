filters:
  and:
    - file.folder == "300 Resources/330 Books/331 BookInfo"
views:
  - type: table
    name: Book Shelf
    order:
      - file.name
      - 豆瓣评分
      - 我的评级
      - book_type
      - area
      - 阅读状态
      - 开始时间
      - 读完时间
      - 短评
      - 本地封面图
      - 是否有纸质书
      - 总页数
      - 出版社
      - remark
      - 出版时间
      - 出品方
      - 丛书
      - 定价
      - 副标题
      - 豆瓣页面
      - 译者
      - 原作名
      - author
    sort:
      - property: 读完时间
        direction: DESC
      - property: 开始时间
        direction: DESC
      - property: file.name
        direction: ASC
      - property: 我的评级
        direction: DESC
    columnSize:
      file.name: 214
      note.豆瓣评分: 60
      note.我的评级: 116
      note.book_type: 79
      note.area: 86
      note.阅读状态: 72
      note.本地封面图: 124
      note.短评: 357
      note.是否有纸质书: 70
      note.总页数: 62
      note.出品方: 110
      note.author: 127
  - type: cards
    name: 2025 Reading
    filters:
      or:
        - and:
            - 开始时间 < "2026-01-01"
            - 开始时间 >= "2025-01-01"
        - and:
            - 读完时间 < "2026-01-01"
            - 读完时间 >= "2025-01-01"
    order:
      - file.name
      - 豆瓣评分
      - 我的评级
      - 阅读状态
      - book_type
    sort:
      - property: 阅读状态
        direction: DESC
      - property: 读完时间
        direction: DESC
    image: note.本地封面图
    imageAspectRatio: 1
  - type: cards
    name: cover
    sort:
      - property: created
        direction: DESC
    image: note.本地封面图
  - type: table
    name: 2025BookShelf
    filters:
      and:
        - created >= "2025-01-01"
    order:
      - file.name
      - 豆瓣评分
      - author
      - area
      - book_type
      - 阅读状态
      - 我的评级
      - 短评
      - 开始时间
      - 读完时间
    sort:
      - property: 读完时间
        direction: DESC
      - property: author
        direction: ASC
      - property: created
        direction: DESC
    columnSize:
      file.name: 228
      note.author: 158
      note.area: 126
      note.我的评级: 121
      note.短评: 172
  - type: cards
    name: 2026 Reading
    filters:
      and:
        - 开始时间 < "2027-01-01"
        - 开始时间 >= "2026-01-01"
        - and:
            - 读完时间 < "2027-01-01"
            - 读完时间 >= "2026-01-01"
    order:
      - file.name
      - 豆瓣评分
      - 我的评级
      - 短评
    sort:
      - property: 读完时间
        direction: DESC
    image: note.本地封面图
