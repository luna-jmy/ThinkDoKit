filters:
  and:
    - "!coordinates.isEmpty()"
views:
  - type: table
    name: Address List
    order:
      - file.name
      - aliases
      - coordinates
      - icon
      - color
      - area
      - type
      - status
      - priority
      - created
      - file.tags
    columnSize:
      file.name: 173
      note.aliases: 118
      note.coordinates: 199
      note.icon: 98
      note.area: 85
      note.type: 100
  - type: map
    name: Maps
    coordinates: note.coordinates
    markerIcon: note.icon
    markerColor: note.color
    mapTiles:
      - https://tiles.openfreemap.org/styles/liberty
    mapTilesDark: []
    center: "[22.60558, 113.84591]"
