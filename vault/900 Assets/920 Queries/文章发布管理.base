filters:
  and:
    - file.folder == "200 Areas/220 自媒体/文章"
views:
  - type: table
    name: 所有文章
    order:
      - file.name
      - published
      - created
      - status
      - area
      - 发布平台
      - wechat-publish
      - wechat-title
      - wechat-link
      - wechat-column
      - zhihu-publish
      - zhihu-title
      - zhihu-column
      - zhihu-link
      - zhihu-cover
      - zhihu-topics
    sort:
      - property: created
        direction: DESC
      - property: file.name
        direction: DESC
      - property: publish-date
        direction: DESC
    columnSize:
      file.name: 318
      note.发布平台: 175
      note.status: 102
      note.area: 103
      note.created: 129
      note.wechat-title: 191
      note.wechat-link: 118
      note.zhihu-title: 168
  - type: table
    name: 知乎文章
    filters:
      and:
        - file.path.contains("400 Archive/410 我的输出/文章")
        - 发布平台.contains("知乎")
    order:
      - file.name
      - publish-date
      - published
      - zhihu-title
      - zhihu-column
      - zhihu-link
      - zhihu-cover
      - zhihu-topics
    sort:
      - property: publish-date
        direction: DESC
    columnSize:
      file.name: 253
      note.zhihu-title: 166
      note.zhihu-link: 219
  - type: cards
    name: 公众号文章
    filters:
      and:
        - file.path.contains("400 Archive/410 我的输出/文章")
        - 发布平台.contains("公众号-批判性阅读")
    order:
      - published
      - wechat-title
      - wechat-column
      - wechat-link
    sort:
      - property: wechat-publish
        direction: DESC
    columnSize:
      file.name: 253
      note.wechat-title: 405
    image: note.wechat-cover
    imageAspectRatio: 0.3
