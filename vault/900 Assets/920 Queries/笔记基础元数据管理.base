filters:
  and:
    - file.folder.contains("100 Projects/")
views:
  - type: table
    name: All Notes (excluding Journals)
    filters:
      and:
        - type == "project"
    order:
      - file.name
      - file.folder
      - area
      - type
      - tags
      - keywords
      - status
      - created
      - source
      - priority
      - remark
      - file.ctime
    sort:
      - property: status
        direction: ASC
      - property: type
        direction: ASC
      - property: created
        direction: DESC
      - property: file.folder
        direction: ASC
    columnSize:
      file.name: 300
      file.folder: 200
      note.area: 128
      note.type: 93
      note.tags: 214
      note.keywords: 141
      note.status: 99
      note.source: 126
      note.remark: 144
  - type: table
    name: 100 Projects
    filters:
      and:
        - file.path.contains("100 Projects")
    order:
      - file.name
      - file.path
      - created
      - area
      - type
      - status
      - priority
      - remark
      - source
    sort:
      - property: file.path
        direction: ASC
    columnSize:
      file.name: 300
      file.path: 239
      note.area: 81
      note.type: 93
      note.status: 99
      note.remark: 144
      note.source: 126
  - type: table
    name: 200 Areas
    filters:
      and:
        - file.path.contains("200 Areas")
    order:
      - file.name
      - file.path
      - created
      - area
      - type
      - status
      - priority
      - remark
      - source
    sort:
      - property: file.path
        direction: ASC
  - type: table
    name: 300 Resources
    filters:
      and:
        - file.path.contains("300 Resources")
        - file.path.contains("WorkMemo")
    order:
      - file.name
      - area
      - type
      - created
      - file.path
      - tags
      - status
      - priority
      - keywords
      - source
      - remark
    sort:
      - property: created
        direction: DESC
      - property: file.path
        direction: ASC
    columnSize:
      file.name: 300
      file.path: 382
      note.area: 81
      note.type: 93
      note.tags: 214
      note.status: 99
      note.keywords: 163
      note.source: 126
      note.remark: 144
  - type: table
    name: 500 Journal
    filters:
      and:
        - file.path.contains("500 Journal")
    order:
      - file.name
      - file.path
      - created
      - type
      - area
      - priority
      - remark
      - source
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 107
      file.path: 239
      note.type: 93
      note.area: 128
      note.remark: 144
      note.source: 126
  - type: table
    name: 400 Archive
    filters:
      and:
        - file.path.contains("400 Archive")
    order:
      - file.name
      - file.path
      - created
      - area
      - type
      - status
      - priority
      - remark
      - source
    sort:
      - property: file.path
        direction: ASC
