views:
  - type: table
    name: Table
    filters:
      and:
        - '!file.path.contains("500 Journal")'
        - and:
            - file.folder.contains("300")
    order:
      - file.name
      - file.folder
      - area
      - type
      - tags
      - keywords
      - status
      - created
      - source
      - priority
      - remark
      - file.ctime
    sort:
      - property: file.folder
        direction: ASC
    columnSize:
      file.name: 300
      file.folder: 200
      note.area: 128
      note.type: 93
      note.tags: 214
      note.keywords: 141
      note.status: 99
      note.source: 126
      note.remark: 144
